# ─────────────────────────────────────────────────────────────
# BlueBay Auto Care — environment variables
# Copy this file to ".env" locally. On Vercel, set these in
# Project Settings → Environment Variables (all of them).
# ─────────────────────────────────────────────────────────────

# Database — Neon Postgres connection string (get it from console.neon.tech).
# Looks like: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=""

# ── SMTP (Brevo or any relay) — used by nodemailer to send emails ──
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""        # SMTP login (Brevo: usually your account email)
SMTP_PASS=""        # SMTP password/key (Brevo: the SMTP key from SMTP & API)
# Sender address. MUST be a verified sender in your SMTP account, or the
# provider rejects the send and the API returns a 500.
SMTP_FROM=""
