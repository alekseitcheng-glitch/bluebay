# ─────────────────────────────────────────────────────────────
# BlueBay Auto Care — environment variables
# Copy this file to ".env" locally. On Vercel, set these in
# Project Settings → Environment Variables (all of them).
# ─────────────────────────────────────────────────────────────

# Database — Neon Postgres connection string (get it from console.neon.tech).
# Looks like: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=""

# ── Brevo (Sendinblue) SMTP — used by nodemailer to send emails ──
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_LOGIN=""        # your Brevo SMTP login (usually your account email)
BREVO_SMTP_KEY=""          # the SMTP key from Brevo → SMTP & API → SMTP
# Sender address. MUST be a verified sender in your Brevo account, or
# Brevo will reject the send and the API returns a 500.
BREVO_SENDER_EMAIL=""
